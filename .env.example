# Copy to .env and fill in the values. Never commit .env.

# Postgres container settings (used by docker-compose.yml)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# Host port for the database, e.g. 5432
POSTGRES_PORT=

# Connection string for the app, built from the values above:
# postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@127.0.0.1:<POSTGRES_PORT>/<POSTGRES_DB>
DATABASE_URL=
